config OPLUS_FEATURE_SCHED_ASSIST
	tristate "sched_assist"
	default n
	help
	  turning sched for ui, render and so on to improve UX

config OPLUS_FEATURE_SCHED_UX_PRIORITY
	bool "Ordered UX priority scheduling"
	default n
	depends on OPLUS_FEATURE_SCHED_ASSIST
	help
	  Enable the OnePlus 9R ordered UX runqueue and execution budgets.

config OPLUS_UX_IM_FLAG
	bool "OPlus sched_assist IM flag classification"
	depends on OPLUS_FEATURE_SCHED_ASSIST
	default n
	help
	  Enable the donor IM flag classification used to identify audio tasks.

config OPLUS_CPU_AUDIO_PERF
	tristate "Boost audio RT task placement"
	depends on OPLUS_UX_IM_FLAG
	default n
	help
	  Avoid placing marked audio RT tasks on CPUs whose current idle state
	  has the high exit latency rejected by the OnePlus 9R scheduler.

config OPLUS_FEATURE_AUDIO_OPT
	bool "OPlus audio small-task scheduling"
	depends on OPLUS_FEATURE_SCHED_ASSIST
	default n
	help
	  Track short-running tasks in the active audio process during the camera
	  scene and preserve the OnePlus 9R next-buddy/preemption preference.

config OPLUS_FEATURE_EAS_OPT
	bool "Oplus EAS optimization control plane"
	default n
	help
	  Expose the OnePlus 9R EAS master control and parent directory.

config OPLUS_FEATURE_VT_CAP
	bool "Oplus virtual CPU capacity and group adjustment"
	depends on OPLUS_FEATURE_EAS_OPT
	default n
	help
	  Apply the OnePlus 9R capacity and task-group placement controls.

config OPLUS_CPUFREQ_IOWAIT_PROTECT
	bool "Oplus schedutil I/O-wait protection"
	depends on OPLUS_FEATURE_EAS_OPT
	default n
	help
	  Expose and apply the OnePlus 9R schedutil I/O-wait controls.

config OPLUS_LOCKING_STRATEGY
	bool "OnePlus 9R locking strategy"
	depends on OPLUS_FEATURE_SCHED_ASSIST
	default n
	help
	  Enable the donor mutex, rwsem, and ART futex locking strategy ABI.

config OPLUS_LOCKING_OSQ
	bool "OnePlus 9R optimistic-spin controls"
	depends on OPLUS_LOCKING_STRATEGY
	default n
	help
	  Enable the donor mutex and rwsem optimistic-spin policy controls.

config OPLUS_LOCKING_MONITOR
	bool "OnePlus 9R locking statistics monitor"
	depends on OPLUS_LOCKING_STRATEGY
	default n
	help
	  Expose the donor lock statistics and threshold control plane.
