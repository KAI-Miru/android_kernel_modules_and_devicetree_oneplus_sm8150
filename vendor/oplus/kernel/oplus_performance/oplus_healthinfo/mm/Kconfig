#ifdef OPLUS_FEATURE_HEALTHINFO
config OPLUS_MEM_MONITOR
	bool "memory monitor "
	default n
	help
	 memory monitor.

config OPLUS_ATHENA_MEMORY_ABI
	bool "Athena allocator and swappiness ABI"
	depends on OPLUS_HEALTHINFO && SLABINFO && !SLOB && OPLUS_ZRAM_OPT
	default n
	help
	  Expose the low-overhead allocator totals and reclaim controls used by
	  the Android 14 OnePlus Athena and Performance AIDL services.  This does
	  not enable the donor's allocation stack tracking or debug caches.
#endif /* OPLUS_FEATURE_HEALTHINFO */
